{
	"source": [
		"../../src/core",
		"../../src/game"
	],
	"ts": {
		"output": "default.project.json",
		"build": "out"
	},
	"project": {
		"name": "game",
		"globIgnorePaths": [
			"**/package.json",
			"**/tsconfig.json"
		],
		"tree": {
			"$className": "DataModel",
			"ReplicatedStorage": {
				"rbxts_include": {
					"$path": "include",
					"node_modules": {
						"$className": "Folder",
						"@rbxts": {
							"$path": "../../node_modules/@rbxts"
						},
						"@flamework": {
							"$path": "../../node_modules/@flamework"
						}
					}
				},
				"Assets": {
					"$path": "assets/ReplicatedStorage"
				}
			},
			"Players": {
				"$properties": {
					"CharacterAutoLoads": false
				}
			},
			"StarterPlayer": {
				"$properties": {
					"EnableMouseLockOption": false
				}
			},
			"ServerStorage": {
				"Assets": {
					"$path": "assets/ServerStorage"
				}
			},
			"Workspace": {
				"$path": "assets/Workspace"
			}
		},
		"syncback": {
			"ignoreGlobs": [
				"out/**",
				"include/**",
				"assets/**/*.rbxm"
			],
			"ignoreClasses": [
				"Camera",
				"Terrain"
			]
		}
	}
}
